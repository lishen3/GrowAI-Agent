{
  "name": "grow-ai",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "build:web": "expo export --platform web --output-dir dist",
    "build:pwa": "npm run build:web && workbox generateSW workbox-config.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "date-fns": "^4.4.0",
    "decode-uri-component": "file:packages/query-decoder-cjs",
    "expo": "^57.0.18",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.2"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "$decode-uri-component"
    }
  },
  "devDependencies": {
    "@expo/cli": "^57.0.20",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "workbox-cli": "^7.3.0"
  }
}
