  "adaptiveRules": [
    {
      "id": "rule_course_first",
      "description": "学校课程和近期DDL属于Locked Priority，不被项目、健身或额外学习覆盖。"
    },
    {
      "id": "rule_english_minimum",
      "description": "普通情况下英语每天保持学习。极忙日允许降低至30至45分钟，而不是直接取消。"
    },
    {
      "id": "rule_internship_mode",
      "description": "如果正式进入日常实习，专业学习和GrowAI项目时间自动降低，工作日晚上优先英语和恢复。"
    },
    {
      "id": "rule_project_priority",
      "description": "GrowAI必须先保证V0.1基础闭环稳定，再进入LLM、Agent、RAG和Memory。"
    },
    {
      "id": "rule_no_overload",
      "description": "单日最多安排3个高认知任务。课程较多时只保留英语和一个核心任务。"
    },
    {
      "id": "rule_fitness",
      "description": "正常周健身3次；四级冲刺、考试或严重过载周允许降低到2次。"
    },
    {
      "id": "rule_ai_learning",
      "description": "专业学习遵循Learned→Practiced→Applied→Built，不把单纯观看教程视为最终Achievement。"
    }
  ]
}
