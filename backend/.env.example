EXPO_PUBLIC_GROWAI_API_URL=http://localhost:8000
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
# Streaming transport controls (legacy LLM_TIMEOUT_SECONDS does not override these).
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT_STREAM=60
LLM_READ_TIMEOUT_NONSTREAM=150
LLM_WRITE_TIMEOUT=10
LLM_POOL_TIMEOUT=10
LLM_STREAM=true
